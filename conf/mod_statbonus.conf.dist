[worldserver]

########################################
# mod-statbonus configuration
#
# Permanent flat additions to a character's five primary stats, held in
# `character_stat_bonus` in the characters database and applied at the last
# moment of the stat calculation, so they present as base stat: white text on
# the character sheet, no buff icon, and everything derived from the stat
# (health from stamina, spell power from intellect) follows.
#
#   .statbonus add <player> <stat> <amount>     add to what they already have
#   .statbonus set <player> <stat> <amount>     set the total outright
#   .statbonus clear <player> [stat]            one stat, or all five
#   .statbonus list [player]                    the realm, or one character
#   .statbonus reload                           re-read the table
#
# <stat> is strength, agility, stamina, intellect or spirit (str/agi/sta/int/
# spi also work, as does the raw index 0-4). <amount> may be negative. The
# stat shown to the client is floored at zero however negative the bonus.
#
# Grants apply to offline characters too, and take effect at their next login.
########################################
#
#    StatBonus.Enable
#        Description: Apply granted stat bonuses.
#                     Turning this off leaves the grants in the table but stops
#                     them counting, which is the quickest way to tell whether
#                     something odd on a character is coming from this module.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

StatBonus.Enable = 1

#
#    StatBonus.Limit
#        Description: Largest absolute bonus the commands will write to one
#                     stat. A limit of 50 permits -50 as well, and a request
#                     beyond it is clamped rather than refused, with the clamp
#                     reported back.
#
#                     This guards against a mistyped amount, not against the
#                     grants themselves - a bonus is flat and stacks with gear
#                     without any cap of its own, so a stray extra digit is
#                     otherwise a character with 3000 strength.
#        Default:     0 - (No limit)

StatBonus.Limit = 0
