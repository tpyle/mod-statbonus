[worldserver]

########################################
# mod-statbonus configuration
#
# Permanent flat additions to a character's five primary stats, its twenty-five
# combat ratings and its seven resistance schools, held in
# `character_stat_bonus` in the characters database.
#
# A stat bonus presents as base stat: white text on the character sheet, no buff
# icon, and everything derived from the stat (health from stamina, spell power
# from intellect) follows. A rating bonus goes in where gear puts its ratings,
# so hit, expertise, dodge, parry, crit, haste and the rest are
# indistinguishable from the same amount off an item - including haste actually
# making the character swing and cast faster. Resistances, and armor with them,
# go into the same accumulator gear feeds, so they read as part of the total the
# character sheet shows.
#
#   .statbonus add <player> <what> <amount>     add to what they already have
#   .statbonus set <player> <what> <amount>     set the total outright
#   .statbonus clear <player> [what]            one bonus, or all of them
#   .statbonus list [player]                    the realm, or one character
#   .statbonus names                            everything <what> accepts
#   .statbonus reload                           re-read the table
#
# MOVEMENT IS A PERCENTAGE, not a flat addition like everything else here. A
# speed is a rate where 1.0 is normal, and the yards per second come from the
# core's table - 7.0 running, 4.722222 swimming - so a flat 1 would mean double
# speed. The stored integer is read as a percentage instead: 1 is 1%, 25 is a
# quarter again. It is added to the rate rather than multiplied into it, so the
# same grant is worth the same whether the character is on foot or mounted.
#
# <what> is strength, agility, stamina, intellect or spirit; a rating - dodge,
# parry, block, hit, crit, haste, expertise, defense, armor_penetration, the
# _ranged and _spell forms of hit/crit/haste, the hit_taken and crit_taken
# ones, and the weapon skills; or a resistance - armor, fire, frost, nature,
# shadow, arcane, holy; or a movement rate - speed (meaning run_speed),
# swim, fly, and the rest by name. Abbreviations
# (str/agi/arp/melee_hit/frost_res) work, and stat:<n> / rating:<n> /
# resist:<n> / movement:<n> address the core's enums by index.
# ".statbonus names" prints the lot. A bare number is refused, because it
# would have to mean one of the three and any reading is wrong most of the
# time.
#
# Note that "haste", "hit" and "crit" on their own are the MELEE ratings, and
# each has its own row per tab: the Spells tab reads haste_spell and hit_spell.
# Note also that armor is resistance school 0 and is not armor_penetration,
# which is a rating.
#
# <amount> may be negative. A shown stat is floored at zero however negative
# the bonus, because the field itself is unsigned.
#
# Grants apply to offline characters too, and take effect at their next login.
########################################
#
#    StatBonus.Enable
#        Description: Apply granted bonuses.
#                     Turning this off leaves the grants in the table but stops
#                     them counting, which is the quickest way to tell whether
#                     something odd on a character is coming from this module.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

StatBonus.Enable = 1

#
#    StatBonus.Limit
#        Description: Largest absolute bonus the commands will write to one
#                     stat, rating or resistance. A limit of 50 permits -50,
#                     and a request
#                     beyond it is clamped rather than refused, with the clamp
#                     reported back.
#
#                     This guards against a mistyped amount, not against the
#                     grants themselves - a bonus is flat and stacks with gear
#                     without any cap of its own, so a stray extra digit is
#                     otherwise a character with 3000 strength, or one who
#                     never misses.
#
#                     One number covers both kinds, and they are not on the
#                     same scale: a rating worth having is tens or hundreds of
#                     points where a stat is single digits. Set it for the
#                     ratings and grant stats well under it.
#        Default:     0 - (No limit)

StatBonus.Limit = 0

#
#    StatBonus.SpeedLimit
#        Description: The same, for movement, which has its own ceiling because
#                     it is the one kind measured in percentage points. A limit
#                     tuned for combat ratings, where a useful grant is in the
#                     hundreds, would allow twenty times normal speed.
#        Default:     0 - (No limit)

StatBonus.SpeedLimit = 0

#
#    StatBonus.Quest.Enable
#        Description: The quest chain: the fragment that starts it, the broker
#                     who takes it, and the turn-in that pays the bonus.
#
#                     This is the master switch, where .QuestRewards below only
#                     stops the payout. Off, the chain goes dormant rather than
#                     half-working: no broker is summoned, no bonus is paid, a
#                     fragment still in a bag says nothing answers, and
#                     accepting the quest tells the player to abandon it. That
#                     last one is needed because the quest is started by an
#                     item and there is no hook to refuse an accept, so a
#                     fragment picked up before the switch can still open it.
#
#                     The quest itself is left in the database untouched, so
#                     turning this back on restores it as it was.
#        Default:     1 - (Enabled)

StatBonus.Quest.Enable = 1

#
#    StatBonus.QuestRewards
#        Description: Let a quest grant a bonus on turn-in, from the pool in
#                     the world table statbonus_quest_reward. Several rows
#                     sharing a QuestId make the quest random, one row makes it
#                     fixed, and the Kind/Id columns are the same vocabulary as
#                     the commands - so a quest can award a stat, a rating, a
#                     resistance or a movement percentage without a rebuild.
#        Default:     1 - (Enabled)

StatBonus.QuestRewards = 1

#
#    StatBonus.Token.Items / .Count / .Creatures
#        Description: The items handed to every member of the killing party
#                     when one of the listed creatures dies, and mailed to
#                     anybody whose bags are full.
#
#                     This is done here rather than with loot because loot
#                     cannot do it: a quest item only drops for somebody
#                     already on the quest, and an ordinary item drops once for
#                     one looter.
#
#                     A comma separated list, and ONE ROLL PICKS ONE ENTRY.
#                     That is the whole point of the list: five items behind a
#                     10% boss stay a 10% chance of getting one of them, where
#                     rolling each separately would mean the same dial handing
#                     out five times as much loot. Adding an item therefore
#                     changes what drops and not how often.
#
#                     The pick is unweighted. What each item grants is
#                     weighted, in statbonus_item_reward.
#
#                     StatBonus.Token.Item - the old name, from when only one
#                     was possible - is still read when .Items is unset.
#        Default:     "" / 1 / "" - (hand out nothing)

StatBonus.Token.Items = ""
StatBonus.Token.Count = 1
StatBonus.Token.Creatures = ""

#
#    StatBonus.Token.Chance / .DungeonChance / .HeroicChance / .RaidChance
#                            / .AnyChance
#        Description: Drop chances for the token, as a percent rolled per
#                     player. 0 switches a source off, so there is one dial per
#                     source and no separate enable.
#
#                     Fractions are allowed, and .AnyChance is why: a chance on
#                     every kill in the world is only useful well below 1%, and
#                     a whole-number percent could only say 0 or 1.
#
#                     .Chance covers the creatures named above.
#
#                     .AnyChance covers EVERY OTHER KILL IN THE WORLD, which
#                     makes it the one dial here that needs thinking about
#                     before it is turned up:
#
#                       0.01   one mote per 10,000 kills
#                       0.1    one per 1,000 - a long evening's killing
#                       1      one per 100, which is a mote every few minutes
#                              and almost certainly not what was meant
#
#                     What counts as a kill is the core's own test for whether
#                     a kill paid experience or honour, rather than a list kept
#                     here: greys, critters, totems, pets and anything flagged
#                     NO_XP are all out. So a level 80 cannot farm starter-zone
#                     wolves, and nothing comes off training dummies or other
#                     people's minions.
#
#                     This one goes to whoever landed the killing blow, and to
#                     a pet's owner when the pet did, rather than to the group:
#                     out in the world "the same map" is a whole continent, and
#                     a party member questing elsewhere on it has no business
#                     rolling off a kill they were nowhere near. The named
#                     creatures above still spread to everybody present, which
#                     is the point of them.
#
#                     The other three cover the final boss of anything the
#                     dungeon finder would pay a random-dungeon bag for. That
#                     is not a list kept here: instance_encounters
#                     marks an encounter as finishing a dungeon with its
#                     lastEncounterDungeon column, and this reads the same
#                     dungeon id out of the same place the finder does, so the
#                     two can never disagree about what the last boss is.
#
#                     They are separate because that set spans all three: of
#                     the 127 encounters marked final, 60 are normal dungeons,
#                     32 are heroics, and 35 are raids up to and including
#                     Icecrown Citadel.
#
#                     Rolled per player, so a chance below 100 is each person's
#                     own luck rather than everybody sharing one result.
#        Default:     100 / 0 / 0 / 0 / 0 - (named creatures always, bosses and
#                     the rest of the world never)

StatBonus.Token.Chance = 100
StatBonus.Token.DungeonChance = 0
StatBonus.Token.HeroicChance = 0
StatBonus.Token.RaidChance = 0
StatBonus.Token.AnyChance = 0

#
#    StatBonus.Token.SkipBots
#        Description: Do not hand tokens to playerbots, which would never use
#                     them or turn them in.
#        Default:     1 - (Enabled)

StatBonus.Token.SkipBots = 1

#
#    StatBonus.Broker.Entry / .DespawnSeconds
#        Description: A creature summoned next to the player when they accept a
#                     quest that has a reward pool, to take it from them, and
#                     despawning after the given time. 0 summons nobody.
#
#                     Summoned on accept rather than from the item's own use
#                     because that needs a spell, and a new spell needs a row
#                     in Spell.dbc and so a client patch.
#                     item_template.StartQuest makes the item start the quest by
#                     itself, which is the same single click.
#        Default:     0 / 120 - (summon nobody)

StatBonus.Broker.Entry = 0
StatBonus.Broker.DespawnSeconds = 120
